-		iwm_stop_device(sc);
-		iwm_init_hw(sc);
+		/*
+		 * Take the full stop+init road for every downgrade into
+		 * INIT, INIT included: the soft reset (stop_device +
+		 * init_hw) leaves the firmware's scan engine unready, and
